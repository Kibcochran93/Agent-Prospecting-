# Required
OPENAI_API_KEY=

# Models. Check the current models page before pinning these.
SEATS_MODEL_PLANNING=gpt-5.6-sol
SEATS_MODEL_RESEARCH=gpt-5.6-sol
SEATS_MODEL_REVIEW=gpt-5.6-sol
SEATS_MAX_TURNS=25

# OpenAI-hosted connectors. Access tokens, not API keys.
SHAREPOINT_AUTHORIZATION=
TEAMS_AUTHORIZATION=
OUTLOOK_EMAIL_AUTHORIZATION=
OUTLOOK_CALENDAR_AUTHORIZATION=

# Remote MCP servers.
NOTION_MCP_URL=https://mcp.notion.com/mcp
NOTION_AUTHORIZATION=
# Private app access token (pat-...). Read scopes only: crm.objects.companies.read,
# crm.objects.deals.read, crm.objects.owners.read. Do not grant write scopes.
HUBSPOT_ACCESS_TOKEN=
# Deals and owners need BOTH the API scope on the private app AND the deals-read
# USER permission on whoever created it, and scope changes must be committed in
# the HubSpot UI before they take effect. A 403 naming [deals-read] means the
# user permission; a 403 naming crm.objects.deals.read means the scope.
HUBSPOT_DEALS_ENABLED=true
# Whose accounts need no owner review. Everything owned by anyone else is
# flagged and the ledger record is forced to 'Pending owner review'.
KIB_HUBSPOT_OWNER_ID=77758126
OPERATOR_NAME=Kib Cochran
HUBSPOT_MCP_URL=https://mcp.hubspot.com/anthropic
HUBSPOT_AUTHORIZATION=
APOLLO_MCP_URL=https://mcp.apollo.io/mcp
APOLLO_AUTHORIZATION=

# Ledger write. Unset either one and both workers fall back to manual paste.
NOTION_API_KEY=
NOTION_LEDGER_DB_ID=          # SE Prospecting Ledger database id

# Apollo sequence write. Leave false until preflight passes and you have read
# the approval payload once for real.
# Runaway guard on credit spend per run, not an approval gate.
APOLLO_REVEAL_CAP=25
APOLLO_SEQUENCE_WRITE=true
APOLLO_MAILBOX_ID=
# Apollo OAuth. The only way a write is Kib's rather than the workspace's
# longest-standing admin: an api key is not a person, an access token is.
# Register at Settings > Integrations > API Keys > OAuth registration with
# redirect http://localhost:8765/callback and scopes:
#   emailer_campaigns_create read_user_profile
# Then: python -m seats_prospecting.apollo_oauth login
APOLLO_OAUTH_CLIENT_ID=
APOLLO_OAUTH_CLIENT_SECRET=
APOLLO_OAUTH_REDIRECT=http://localhost:8765/callback
APOLLO_OAUTH_SCOPES=
APOLLO_TOKEN_FILE=./.apollo_token.json

APOLLO_EXPECTED_USER=

# Ledger write path. "outbox" (default) writes JSON to LEDGER_OUTBOX_DIR and the
# agents hold no Notion capability at all. "direct" posts to Notion with
# NOTION_API_KEY, which must be an insert-only integration.
LEDGER_WRITE_MODE=outbox
LEDGER_OUTBOX_DIR=./ledger-outbox

# Motion names the Notion Motion select accepts. Authoritative source is the
# Sales_Motions sheet of the ABM US Playbook v3.1. There is no M8. Add the same
# options to the Notion property or writes using them will be rejected.
LEDGER_MOTIONS="Unclear,M1 Schedule Replacement,M2 Attendance & Evidence,M3 Student Success / Retention,M4 Student Care / Coordinated Care,M5 Compliance & Audit Evidence,M6 Smart Campus / Space Utilization,M7 Education AI / Data Engine,M9 US Health Sciences clock-hour attendance and Title IV evidence"
KNOWLEDGE_DIR=./knowledge

# The Apollo label id for this build's sequences. seats-status filters on it;
# without it the filter falls back to the ' | ' naming convention, which also
# matches unrelated campaigns.
APOLLO_SEQUENCE_LABEL_ID=
